# Existing unique properties, promoted without changing assertions.
if(QUALPF_BUILD_PRODUCT_TESTS)
    function(qualpf_property target source)
        add_executable(${target} "${PROJECT_SOURCE_DIR}/tests/${source}")
        qualpf_configure_qt_boundary(${target} Widgets Sql PrintSupport Network)
        target_link_libraries(${target} PRIVATE qualpf_core qualpf_application qualpf_infrastructure
            qualpf_gui qualpf_qcustomplot qualpf_gui_reference
             ${ARGN})
        if(WIN32)
            target_link_libraries(${target} PRIVATE opengl32)
        endif()
        add_test(NAME ${target} COMMAND ${target})
        set_tests_properties(${target} PROPERTIES LABELS "normal;properties" ENVIRONMENT "QT_QPA_PLATFORM=offscreen;MKL_NUM_THREADS=1")
    endfunction()
    qualpf_property(qualpf_cif_syntax_properties unit/infrastructure/cif/syntax_properties.cpp qualpf::cif_syntax)
    qualpf_property(qualpf_cif_import_properties unit/infrastructure/cif/import_properties.cpp qualpf::cif_import)
    qualpf_property(qualpf_cif_site_symmetry_properties unit/application/cif/site_symmetry_properties.cpp qualpf::cif_card)
    qualpf_property(qualpf_cif_block_properties unit/application/cif/block_properties.cpp qualpf::cif_card)
    qualpf_property(qualpf_cif_card_properties unit/application/cif/card_properties.cpp qualpf::cif_card)
    qualpf_property(qualpf_cif_semantic_properties unit/application/cif/semantic_properties.cpp qualpf::cif_card)
    qualpf_property(qualpf_cif_database_properties integration/database/database_properties.cpp )
    qualpf_property(qualpf_cif_build_properties integration/database/build_properties.cpp qualpf::cif_build)
    qualpf_property(qualpf_presentation_properties unit/application/presentation_properties.cpp)
    qualpf_property(qualpf_export_properties product/export/properties.cpp)
    qualpf_property(qualpf_atomic_export_controls product/export/atomic_semantics.cpp)
    qualpf_property(qualpf_export_schema_controls product/export/qt_schema_controls.cpp)
    foreach(target qualpf_presentation_properties qualpf_export_properties qualpf_atomic_export_controls qualpf_export_schema_controls)
        if(MSVC)
            target_compile_options(${target} PRIVATE /fp:strict)
        else()
            target_compile_options(${target} PRIVATE -fno-fast-math -ffp-contract=off)
        endif()
    endforeach()
    add_subdirectory("${PROJECT_SOURCE_DIR}/tests/profile" "${CMAKE_BINARY_DIR}/tests/profile")
endif()
