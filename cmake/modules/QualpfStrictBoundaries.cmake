# Observe configured target properties, rather than parsing CMake source spelling.
function(qualpf_collect_targets directory output)
    get_property(items DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        qualpf_collect_targets("${child}" nested)
        list(APPEND items ${nested})
    endforeach()
    set(${output} "${items}" PARENT_SCOPE)
endfunction()

function(qualpf_json_string value output)
    string(REPLACE "\\" "/" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(qualpf_enable_strict_boundaries)
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    qualpf_collect_targets("${PROJECT_SOURCE_DIR}" targets)
    set(document "{\n  \"targets\": {")
    set(separator "")
    foreach(target IN LISTS targets)
        string(APPEND document "${separator}\n    \"${target}\": {")
        set(property_separator "")
        foreach(property SOURCE_DIR TYPE SOURCES LINK_LIBRARIES INTERFACE_LINK_LIBRARIES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
            get_property(value TARGET "${target}" PROPERTY "${property}")
            # Resolve aliases, retaining generator-expression wrappers for the reader.
            foreach(link IN LISTS value)
                if(TARGET "${link}")
                    get_target_property(alias "${link}" ALIASED_TARGET)
                    if(alias)
                        string(REPLACE "${link}" "${alias}" value "${value}")
                    endif()
                endif()
            endforeach()
            qualpf_json_string("${value}" encoded)
            string(APPEND document "${property_separator}\n      \"${property}\": ${encoded}")
            set(property_separator ",")
        endforeach()
        string(APPEND document "\n    }")
        set(separator ",")
    endforeach()
    string(APPEND document "\n  }\n}\n")
    set(graph "${CMAKE_BINARY_DIR}/strict-targets.json")
    file(WRITE "${graph}" "${document}")
    add_custom_target(qualpf_strict_boundaries ALL
        COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/architecture/check_strict_boundaries.py"
            --graph "${graph}"
        VERBATIM)
    # The product's explicit target build must pass the same gate as `all`.
    add_dependencies(${EXECUTABLE_NAME} qualpf_strict_boundaries)
    if(QUALPF_BUILD_PRODUCT_TESTS)
        add_test(NAME qualpf.architecture.strict COMMAND "${Python3_EXECUTABLE}"
            "${PROJECT_SOURCE_DIR}/tools/architecture/check_strict_boundaries.py"
            --graph "${graph}" --self-test)
        set_tests_properties(qualpf.architecture.strict PROPERTIES LABELS "normal;public_ci" TIMEOUT 120)
    endif()
endfunction()
