cmake_policy(VERSION 3.20)
set(_qualpf_args --root "@PROJECT_SOURCE_DIR@" --build "@CMAKE_BINARY_DIR@"
    --record-artifacts "${CPACK_PACKAGE_DIRECTORY}/${CPACK_PACKAGE_FILE_NAME}-artifacts.json")
foreach(_qualpf_artifact IN LISTS CPACK_PACKAGE_FILES)
    list(APPEND _qualpf_args --artifact "${_qualpf_artifact}")
endforeach()
if(NOT "@QUALPF_DEPENDENCY_SOURCE_ARCHIVE@" STREQUAL "")
    list(APPEND _qualpf_args --dependency-archive "@QUALPF_DEPENDENCY_SOURCE_ARCHIVE@"
        --artifact "@QUALPF_DEPENDENCY_SOURCE_ARCHIVE@")
endif()
if(CPACK_GENERATOR STREQUAL "IFW")
    list(APPEND _qualpf_args --ifw-metadata "${CPACK_TEMPORARY_DIRECTORY}")
    foreach(_qualpf_tool CPACK_IFW_BINARYCREATOR_EXECUTABLE CPACK_IFW_INSTALLERBASE_EXECUTABLE)
        if(DEFINED ${_qualpf_tool} AND EXISTS "${${_qualpf_tool}}")
            list(APPEND _qualpf_args --tool "${${_qualpf_tool}}")
        endif()
    endforeach()
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" -B "@QUALPF_DISTRIBUTION_CHECKER@" ${_qualpf_args}
    RESULT_VARIABLE _qualpf_status OUTPUT_VARIABLE _qualpf_output ERROR_VARIABLE _qualpf_error)
if(NOT _qualpf_status EQUAL 0)
    message(FATAL_ERROR "QualPF artifact identity recording failed: ${_qualpf_output}${_qualpf_error}")
endif()
