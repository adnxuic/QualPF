# Local build trees (root-relative: scripts/build remains a source directory).
/build*/
/cmake-build*/
/debug/
/debug_gfor/
/release/
/release_gfor/

# In-source CMake/Ninja outputs; out-of-source builds are preferred.
/CMakeCache.txt
/CMakeFiles/
/Makefile
/cmake_install.cmake
/install_manifest*.txt
/CTestTestfile.cmake
/Testing/
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log
/compile_commands.json
/CPackConfig.cmake
/CPackSourceConfig.cmake
/configured_files/

# Machine-local SDK and IDE settings.
/CMakeUserPresets.json
/CMakeLists.txt.user*
/.qtcreator/
/.vs/
/.idea/
/run_gui.bat

# Local databases and release/package products.
/DB/
/releases/
/_CPack_Packages/
/*.deb
/*.AppImage
/QualXPF-*-win64.exe
/QualPF-*-win64.exe

# Local example collections; retain the independently tracked CoO fixture.
/tests/real_example_data/*
!/tests/real_example_data/03_reference_structures/
/tests/real_example_data/03_reference_structures/*
!/tests/real_example_data/03_reference_structures/CoO.cif

# Documentation build outputs and local Python environments.
/.venv/
/docs/.venv/
/docs/site/
/docs/qualx_manual.pdf
/docs/qualpf_manual.pdf
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Materialized historical evidence; tracked reviews and frozen inputs remain.
/.evidence/
/docs/refactoring/phase-19/
/docs/refactoring/phase-20/profile-core/entry-*/
/docs/refactoring/phase-20/profile-core/native-oracle-*/
/docs/refactoring/phase-20/profile-core/native-oracle-*.zip

# Scientific input/reference formats are intentionally not ignored globally.
# Place new generated outputs in a local build tree, not beside source fixtures.
